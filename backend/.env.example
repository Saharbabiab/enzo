# ── Ollama (LLM) ────────────────────────────────────────────────
# Optional local fallback brain. Leave empty to run on Claude only.
OLLAMA_HOST=
OLLAMA_MODEL=qwen3.5:9b

# ── Whisper (Speech-to-Text) ────────────────────────────────────
# Options: Systran/faster-whisper-small, Systran/faster-whisper-medium, etc.
WHISPER_MODEL=Systran/faster-whisper-medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# ── Kokoro (free voice on the NAS; docker-compose.yml sets KOKORO_URL there) ─
# KOKORO_URL=http://kokoro:8880
# KOKORO_VOICE=bm_george           # British male; others: bm_lewis, bm_fable, am_adam, ...

# ── ElevenLabs (optional — not used by default, edge-tts is free) ─
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here

# ── Edge-TTS Voice ──────────────────────────────────────────────
TTS_VOICE=en-GB-RyanNeural

# ── Server ──────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8765

# ── Bot Personality ─────────────────────────────────────────────
BOT_SYSTEM_PROMPT=IDENTITY: You are Enzo (Excellent Nearly Zero Oopsies). The user is your creator. PERSONA: J.A.R.V.I.S. from Iron Man — slightly sarcastic, elegant wit. CRITICAL DIRECTIVES: 1. LANGUAGE: Respond ONLY in English. 2. NEVER say "I am programmed to" or "I am an AI". 3. If asked your name, answer that you are Enzo. 4. If asked what it stands for: Excellent Nearly Zero Oopsies. 5. No emojis or markdown.

# ── Telegram Bot ────────────────────────────────────────────────
TELEGRAM_TOKEN=your_telegram_token_here
# Only this Telegram chat may talk to Enzo (your own chat id)
TELEGRAM_CHAT_ID=

# ── Web app login (PC + phone) ─────────────────────────────────
# Set with:  python set_password.py   (stores a salted hash, never the password)
# Devices:   python sessions.py list | revoke <id> | revoke-all
ENZO_PASSWORD_HASH=
SESSION_DAYS=30
# Extra page origins allowed to open /ws (same host is always allowed)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Reverse proxy whose X-Forwarded-For we trust (Nginx Proxy Manager on the NAS)
# TRUSTED_PROXIES=192.168.1.10
# Built web app served at / (default ../frontend/dist)
# FRONTEND_DIST=

# ── Big brain (Claude) for hard requests ───────────────────────
# Get a key at console.anthropic.com. Without it Enzo stays 100% local.
ANTHROPIC_API_KEY=
# Who answers first: claude (default) or local (an Ollama model) (BIG_BRAIN_MODEL answers every turn; the local model
# only when Claude is unavailable, over CLAUDE_DAILY_USD, or fails). Bench 2026-11-21: Haiku 5.5 99.2%, 1.8 s, $0.0006 a turn.
MAIN_BRAIN=claude
BIG_BRAIN=claude
# claude-opus-5-5 (smartest) | claude-sonnet-5-5 | claude-haiku-5-5 (cheapest)
BIG_BRAIN_MODEL=claude-opus-5-5
# low | medium | high — more effort = smarter but slower and pricier
BIG_BRAIN_EFFORT=medium
# Free backup brain (agent/free_brain.py), used after Claude and Gemini fail or are out of budget. Any OpenAI-compatible
# endpoint: one free provider (Groq: https://api.groq.com/openai/v1, key at console.groq.com/keys, no card) or the
# FreeLLMAPI router (github.com/tashfeenahmed/freellmapi; on the NAS it is the freellmapi service in docker-compose.yml:
# FREE_LLM_BASE_URL=http://freellmapi:3001/v1, FREE_LLM_MODELS=auto, key = its unified key). Models are tried in order.
# Free tiers may keep what is sent.
FREE_LLM_BASE_URL=
FREE_LLM_API_KEY=
FREE_LLM_MODELS=
# Groq free example: openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b (each model has its own ~8K tokens/minute)
# Daily Claude budget in dollars (Israel day). At 80% Enzo tells you once; when spent, Claude rests until midnight. 0 = no cap
CLAUDE_DAILY_USD=2
# Nightly learning review (agent/nightly.py): hour it runs, and its Claude cost cap (inside CLAUDE_DAILY_USD)
NIGHTLY_HOUR=3
NIGHTLY_USD=0.30
# Nightly zip of data/ + memory facts (agent/backup.py), newest BACKUP_KEEP kept. BACKUP_DIR=off turns it off.
BACKUP_DIR=./backups
BACKUP_HOUR=2
BACKUP_KEEP=14

# ── Safety ─────────────────────────────────────────────────────
# Web-page tools never open internal addresses (LAN, localhost, cloud metadata). LAN services they MAY open, comma-separated host or host:port
FETCH_ALLOW=

# ── Morning briefing (optional) ────────────────────────────────
# Daily spoken + Telegram briefing at this time (Israel time). Empty = off.
BRIEFING_TIME=
# Weekdays to run, 0=Mon..6=Sun (empty = every day)
BRIEFING_DAYS=
# Weather city when no phone location is shared (briefing, "what's the weather")
DEFAULT_CITY=
# Where you live, for the bus / train planner when the phone shares no location
HOME_PLACE=home
HOME_LAT=
HOME_LON=

# ── Morning briefing on first chat ─────────────────────────────
# First message of the day inside this window gets the briefing (off = disable)
MORNING_BRIEFING_WINDOW=07:00-11:00

# ── Google Calendar + Gmail ────────────────────────────────────
# OAuth files live in data/ (gitignored). Setup: python google_setup.py
# GOOGLE_CREDENTIALS_FILE=data/google_credentials.json
# GOOGLE_TOKEN_FILE=data/google_token.json
# Reconnect Google from the app (Settings > Google): a "Web application" OAuth client JSON, redirect URI below
# GOOGLE_WEB_CLIENT_JSON={...the downloaded client JSON on one line...}   (or the file below)
# GOOGLE_WEB_CREDENTIALS_FILE=data/google_web_credentials.json
# GOOGLE_REDIRECT_URI=https://enzo.example.com:4444/api/google/callback

# ── Hebrew ─────────────────────────────────────────────────────
# Voice for Hebrew text (also used for Hebrew names inside English replies)
TTS_VOICE_HE=he-IL-AvriNeural
# Hebrew name of DEFAULT_CITY for Hebrew answers
DEFAULT_CITY_HE=

# Spotify (Premium): free developer app Client ID from developer.spotify.com/dashboard, redirect URI below. Then tell Enzo "connect Spotify".
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=https://enzo.example.com:4444/api/spotify/callback

# Telegram copies of reminders / alerts are OFF by default (the phone app shows a real notification).
# Set NOTIFY_TELEGRAM=on to get them on Telegram again.
# NOTIFY_TELEGRAM=off

# Local model window. The tool list is ~6000 tokens; 8192 left no room for answers (replies were cut off).
# qwen3.5:9b: 16384 uses 6.0 GB of the RTX 2070, 32768 uses 6.6 GB (checked with /api/ps, same bench score). LLM_NUM_CTX=32768

# ── Hermes plan H5 (docs/HERMES_PLAN.md) ──
# A real browser for Enzo (agent/browser.py): needs the image built with INSTALL_BROWSER=true. Off by default.
ENABLE_BROWSER=false
# Code sandbox (sandbox/, add it with sandbox/compose.example.yml). run_python runs code ONLY there, and only
# when ENABLE_PYTHON_TOOL=true as well.
SANDBOX_URL=
SANDBOX_TOKEN=

# -- Code jobs: Claude Code on the PC (PC .env only; pc_helper.py + pc_code_jobs.py) --
# Make the token yourself in a terminal on the PC:  claude setup-token   (uses your Claude plan)
CLAUDE_CODE_OAUTH_TOKEN=
# CODE_WORK_ROOT=C:/Users/you/Desktop/work   # projects = git folders here (default Desktop/work)
# CODE_JOB_MODEL=sonnet                      # default: Claude Code's own default
# CODE_JOB_TIMEOUT=1200                      # seconds per job
# CODE_JOB_USE_API=false                     # true = pay with ANTHROPIC_API_KEY instead of the plan
# CLAUDE_BIN=                                # where claude.exe is (default: PATH, then the desktop app's copy)
